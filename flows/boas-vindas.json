  "connections": [
    { "from": "inicio", "to": "saudacao" },
    { "from": "saudacao", "output": "answered", "to": "marca_lead" },
    { "from": "marca_lead", "to": "funil" },
    { "from": "funil", "to": "avisa_transferencia" },
    { "from": "avisa_transferencia", "to": "atendente" },
    { "from": "atendente", "to": "fim" },
    { "from": "saudacao", "output": "timeout", "to": "sem_resposta" },
    { "from": "sem_resposta", "to": "marca_frio" },
    { "from": "marca_frio", "to": "fim" }
  ]
