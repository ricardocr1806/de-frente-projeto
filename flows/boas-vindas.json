{
  "name": "Boas-vindas e triagem",
  "status": "draft",
  "blocks": [
    { "id": "inicio", "type": "trigger", "match": "any" },
    {
      "id": "saudacao",
      "type": "text",
      "text": "Oi {{nome}}! Aqui é da equipe. Me conta rapidinho o que você procura?",
      "wait_reply": true,
      "timeout_seconds": 3600
    },
    { "id": "marca_lead", "type": "tag_add", "tag": "lead-whatsapp" },
    { "id": "funil", "type": "pipeline", "pipeline": "Vendas", "stage": "Novo lead" },
    { "id": "avisa_transferencia", "type": "text", "text": "Perfeito! Já estou te passando para um consultor." },
    { "id": "atendente", "type": "transfer", "assign_type": "team", "team": "Comercial" },
    { "id": "sem_resposta", "type": "text", "text": "Fico por aqui, mas é só chamar quando puder falar. 👋" },
    { "id": "marca_frio", "type": "tag_add", "tag": "sem-resposta" },
    { "id": "fim", "type": "end" }
